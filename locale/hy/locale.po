msgstr "Արագ ներկայացում OMP-ի համար"

#, fuzzy
msgid "plugins.generic.quickSubmitOmp.description"
msgstr "Մեկ էջում ավելացնում է գիրքը, նրա մասնակիցներին, գլուխները՝ իրենց PDF-ով, և վերջնական ձևաչափերը, ու հրապարակում է այն՝ բոլոր ֆայլերը հաստատված և բաց հասանելիությամբ։ Խմբագրված հատորի դեպքում գրքի մետատվյալներում նշվում են միայն հատորի խմբագիրները, իսկ յուրաքանչյուր գլխում՝ նրա սեփական հեղինակները։"

